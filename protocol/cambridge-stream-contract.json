{
  "name": "cambridge-stream",
  "protocolVersion": 6,
  "control": {
    "framing": "uint32-be-length-prefixed-json",
    "maxMessageBytes": 8192,
    "connectTimeoutMs": 2000,
    "requestTimeoutMs": 2000
  },
  "discovery": {
    "version": 1,
    "serviceType": "_cambridge._tcp",
    "txtKeys": ["id", "name", "protocolVersion", "codec", "discoveryVersion", "address<N>"],
    "addressKeyPrefix": "address",
    "addressFamily": "ipv4",
    "maximumAddressCount": 16
  },
  "receiver": {
    "defaultId": "cambridge-obs-source",
    "defaultDisplayName": "OBS receiver"
  },
  "defaults": {
    "controlPort": 55031,
    "mediaPortOffset": 1
  },
  "geometry": {
    "minimumDimension": 16,
    "dimensionAlignment": 2,
    "maximumLongEdge": 3840,
    "maximumShortEdge": 2160,
    "rotationDegrees": [0, 90, 180, 270]
  },
  "video": {
    "minimumFps": 1,
    "maximumFps": 120
  },
  "bitrate": {
    "minimumBps": 100000,
    "maximumBps": 100000000
  },
  "media": {
    "transport": "rtp-h264-udp-unicast",
    "payloadType": 96,
    "clockRateHz": 90000,
    "rtpHeaderBytes": 12,
    "mtuBytes": 1200,
    "maxDatagramBytes": 1500,
    "maxAccessUnitBytes": 8388608,
    "maxInFlightAccessUnits": 2,
    "maxReorderPackets": 64,
    "mailboxCapacity": 1,
    "texturePoolSlots": 3,
    "maxDecoderQueueAgeMs": 100,
    "maxLiveFrameAgeMs": 250,
    "reorderDeadlineMs": 20,
    "keyframeIntervalSeconds": 1
  },
  "messages": {
    "probe": "{protocolVersion:6, type:probe, requestId}",
    "capabilities": "{protocolVersion:6, type:capabilities, requestId, receiverId, displayName, maxLongEdge, maxShortEdge}",
    "hello": "{protocolVersion:6, type:hello, sessionId, generation, profileId, codec, codedWidth, codedHeight, rotationDegrees, fps, bitrateBps}",
    "accepted": "{protocolVersion:6, type:accepted, sessionId, generation, profileId, mediaPort, maxLongEdge, maxShortEdge}",
    "stop": "{protocolVersion:6, type:stop, sessionId, generation}",
    "error": "{protocolVersion:6, type:error, error}"
  }
}
