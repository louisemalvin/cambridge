{
  "protocolVersion": 1,
  "media": {
    "transport": "mpegts-udp",
    "portAssignment": "per_session"
  },
  "videoCodecs": [
    {
      "codec": "h265",
      "supported": true,
      "decoderAcceleration": "unknown"
    },
    {
      "codec": "h264",
      "supported": true,
      "decoderAcceleration": "unknown"
    }
  ],
  "output": {
    "device": "/dev/video10",
    "pixelFormats": ["yuy2", "nv12", "i420"]
  },
  "session": {
    "maximumConcurrentSessions": 1,
    "active": false
  }
}
