{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mobile-webcam.dev/protocol/sender-control-v2.schema.json",
  "title": "Mobile Webcam sender reverse-control protocol v2",
  "oneOf": [
    { "$ref": "#/$defs/describeSenderRequest" },
    { "$ref": "#/$defs/senderAdvertisement" },
    { "$ref": "#/$defs/startStreamRequest" },
    { "$ref": "#/$defs/startStreamResponse" },
    { "$ref": "#/$defs/stopStreamRequest" },
    { "$ref": "#/$defs/stopStreamResponse" }
  ],
  "$defs": {
    "protocolVersion": { "const": 2 },
    "streamId": { "type": "string", "format": "uuid", "minLength": 1 },
    "describeSenderRequest": {
      "type": "object",
      "required": ["protocolVersion", "action"],
      "properties": {
        "protocolVersion": { "$ref": "#/$defs/protocolVersion" },
        "action": { "type": "string", "const": "describe" }
      },
      "additionalProperties": true
    },
    "senderAdvertisement": {
      "type": "object",
      "required": [
        "protocolVersion",
        "action",
        "senderId",
        "displayName",
        "controlPort",
        "availability"
      ],
      "properties": {
        "protocolVersion": { "$ref": "#/$defs/protocolVersion" },
        "action": { "type": "string", "const": "describe_result" },
        "senderId": { "type": "string", "minLength": 1 },
        "displayName": { "type": "string", "minLength": 1 },
        "controlPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "availability": {
          "type": "string",
          "enum": ["standby", "streaming", "busy"]
        }
      },
      "additionalProperties": true
    },
    "startStreamRequest": {
      "type": "object",
      "required": [
        "protocolVersion",
        "action",
        "streamId",
        "receiverId",
        "receiverName",
        "receiverControlPort"
      ],
      "properties": {
        "protocolVersion": { "$ref": "#/$defs/protocolVersion" },
        "action": { "type": "string", "const": "start" },
        "streamId": { "$ref": "#/$defs/streamId" },
        "receiverId": { "type": "string", "minLength": 1 },
        "receiverName": { "type": "string", "minLength": 1 },
        "receiverControlPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "pairingToken": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "startStreamResponse": {
      "type": "object",
      "required": ["protocolVersion", "action", "streamId", "senderId", "status"],
      "properties": {
        "protocolVersion": { "$ref": "#/$defs/protocolVersion" },
        "action": { "type": "string", "const": "start_result" },
        "streamId": { "$ref": "#/$defs/streamId" },
        "senderId": { "type": "string", "minLength": 1 },
        "status": {
          "type": "string",
          "enum": [
            "accepted",
            "approval_required",
            "rejected",
            "busy",
            "camera_permission_required",
            "invalid_request"
          ]
        },
        "pairingToken": { "type": "string", "minLength": 1 },
        "message": { "type": "string" }
      },
      "additionalProperties": true
    },
    "stopStreamRequest": {
      "type": "object",
      "required": ["protocolVersion", "action", "streamId", "receiverId", "pairingToken"],
      "properties": {
        "protocolVersion": { "$ref": "#/$defs/protocolVersion" },
        "action": { "type": "string", "const": "stop" },
        "streamId": { "$ref": "#/$defs/streamId" },
        "receiverId": { "type": "string", "minLength": 1 },
        "pairingToken": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "stopStreamResponse": {
      "type": "object",
      "required": ["protocolVersion", "action", "streamId", "senderId", "status"],
      "properties": {
        "protocolVersion": { "$ref": "#/$defs/protocolVersion" },
        "action": { "type": "string", "const": "stop_result" },
        "streamId": { "$ref": "#/$defs/streamId" },
        "senderId": { "type": "string", "minLength": 1 },
        "status": {
          "type": "string",
          "enum": ["stopped", "already_stopped", "stale_stream", "rejected", "invalid_request"]
        },
        "message": { "type": "string" }
      },
      "additionalProperties": true
    }
  }
}
