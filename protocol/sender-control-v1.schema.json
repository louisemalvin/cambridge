{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mobile-webcam.dev/protocol/sender-control-v1.schema.json",
  "title": "Mobile Webcam sender reverse-control protocol v1",
  "oneOf": [
    { "$ref": "#/$defs/describeSenderRequest" },
    { "$ref": "#/$defs/senderAdvertisement" },
    { "$ref": "#/$defs/startStreamRequest" },
    { "$ref": "#/$defs/startStreamResponse" }
  ],
  "$defs": {
    "protocolVersion": { "const": 1 },
    "describeSenderRequest": {
      "type": "object",
      "required": ["protocolVersion", "action"],
      "properties": {
        "protocolVersion": { "$ref": "#/$defs/protocolVersion" },
        "action": { "type": "string", "const": "describe" }
      },
      "additionalProperties": true
    },
    "senderAdvertisement": {
      "type": "object",
      "required": ["protocolVersion", "senderId", "displayName", "controlPort"],
      "properties": {
        "protocolVersion": { "$ref": "#/$defs/protocolVersion" },
        "senderId": { "type": "string", "minLength": 1 },
        "displayName": { "type": "string", "minLength": 1 },
        "controlPort": { "type": "integer", "minimum": 1, "maximum": 65535 }
      },
      "additionalProperties": true
    },
    "startStreamRequest": {
      "type": "object",
      "required": ["protocolVersion", "receiverId", "receiverName", "receiverControlPort"],
      "properties": {
        "protocolVersion": { "$ref": "#/$defs/protocolVersion" },
        "receiverId": { "type": "string", "minLength": 1 },
        "receiverName": { "type": "string", "minLength": 1 },
        "receiverControlPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "pairingToken": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "startStreamResponse": {
      "type": "object",
      "required": ["protocolVersion", "senderId", "status"],
      "properties": {
        "protocolVersion": { "$ref": "#/$defs/protocolVersion" },
        "senderId": { "type": "string", "minLength": 1 },
        "status": {
          "type": "string",
          "enum": [
            "accepted",
            "approval_required",
            "rejected",
            "busy",
            "camera_permission_required",
            "invalid_request"
          ]
        },
        "pairingToken": { "type": "string", "minLength": 1 },
        "message": { "type": "string" }
      },
      "additionalProperties": true
    }
  }
}
